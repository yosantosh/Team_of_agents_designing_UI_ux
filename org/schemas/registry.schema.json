{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI/UX Agent Company Registry",
  "type": "object",
  "required": ["version", "organization", "owner", "models", "agents", "tiers", "pods", "gates"],
  "properties": {
    "version": { "type": "string" },
    "organization": { "type": "string" },
    "owner": { "type": "string" },
    "description": { "type": "string" },
    "defaults": { "type": "object" },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["provider", "model"],
        "properties": {
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "context_tokens": { "type": "integer" },
          "cost_per_million_input": { "type": "number" },
          "cost_per_million_output": { "type": "number" },
          "purpose": { "type": "string" }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "tier", "enabled", "mission"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "tier": { "type": "integer" },
          "enabled": { "type": "boolean" },
          "prompt_key": { "type": "string" },
          "model": { "type": "string" },
          "real_world_equivalent": { "type": "string" },
          "mission": { "type": "string" },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "tools": { "type": "array", "items": { "type": "string" } },
          "gates": { "type": "array", "items": { "type": "string" } },
          "kpis": { "type": "array", "items": { "type": "string" } },
          "failure_modes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tiers": { "type": "array", "items": { "type": "object" } },
    "pods": { "type": "array", "items": { "type": "object" } },
    "gates": { "type": "array", "items": { "type": "object" } },
    "artifact_types": { "type": "array", "items": { "type": "string" } },
    "evolution_policy": { "type": "object" },
    "metrics": { "type": "array", "items": { "type": "object" } }
  }
}
