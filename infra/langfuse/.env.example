# Langfuse self-hosted environment for docker compose.
# Copy to `.env` and replace every CHANGEME value.
# Generate secrets with: openssl rand -hex 32

# Public URL used by the Langfuse UI and links.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGEME_NEXTAUTH_SECRET

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME_POSTGRES_PASSWORD
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:CHANGEME_POSTGRES_PASSWORD@postgres:5432/postgres

# Session encryption / salts
SALT=CHANGEME_SALT
ENCRYPTION_KEY=CHANGEME_64_HEX_CHARS

# ClickHouse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME_CLICKHOUSE_PASSWORD
CLICKHOUSE_DB=default
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_CLUSTER_ENABLED=false

# Redis / Valkey
REDIS_AUTH=CHANGEME_REDIS_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO / S3
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME_MINIO_PASSWORD
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME_MINIO_PASSWORD
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME_MINIO_PASSWORD
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_INTERNAL_ENDPOINT=http://minio:9000

# Offline / privacy defaults. Set to false only if you want Langfuse telemetry.
TELEMETRY_ENABLED=false

# Optional first-boot provisioning so a fresh offline install already has an
# organization, project, API keys, and a Dictator login. Keep these stable.
LANGFUSE_INIT_ORG_ID=uiux-company
LANGFUSE_INIT_ORG_NAME=UIUX Agent Company
LANGFUSE_INIT_PROJECT_ID=uiux-company-project
LANGFUSE_INIT_PROJECT_NAME=UIUX Agent Company
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-uiux-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-uiux-local-CHANGEME
LANGFUSE_INIT_USER_EMAIL=dictator@local
LANGFUSE_INIT_USER_NAME=Dictator
LANGFUSE_INIT_USER_PASSWORD=CHANGEME_DICTATOR_PASSWORD
