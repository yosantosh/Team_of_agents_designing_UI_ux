# Runtime
UIUX_HOST=127.0.0.1
UIUX_PORT=8765
UIUX_DATA_DIR=./.runtime
UIUX_ARTIFACTS_DIR=./artifacts
UIUX_CHECKPOINT_DB=./.runtime/checkpoints.sqlite3
UIUX_STORAGE_DB=./.runtime/uiux.sqlite3

# Model gateway: opencode | mock
UIUX_MODEL_BACKEND=opencode
UIUX_OPENCODE_BIN=opencode
UIUX_OPENCODE_AGENT=uiux-worker
UIUX_OPENCODE_MODEL=modal/deepseek-v4.1-flash-1017
UIUX_OPENCODE_TIMEOUT=300
UIUX_MAX_CONTEXT_CHARS=120000
# Optional: run OpenCode workers in a clean directory
# UIUX_OPENCODE_CWD=/path/to/clean/workspace

# Approval / autonomy
# L0 advise, L1 spec, L2 PR, L3 auto-merge low risk, L4 auto-release
UIUX_AUTONOMY_LEVEL=L2
UIUX_AUTO_APPROVE=true
UIUX_MAX_REWORK=2

# Token budget (set your monthly ceiling in total tokens)
UIUX_MONTHLY_TOKEN_BUDGET=100000000
UIUX_TOKEN_WARN_PCT=80
UIUX_TOKEN_HARD_STOP_PCT=100

# Target UI
UIUX_TARGET_UI_ENABLED=true
UIUX_TARGET_UI_PATH=./target_ui_example
UIUX_TARGET_UI_ANALYZE=true

# LangSmith (optional; set these to enable tracing)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=uiux-agent-company
