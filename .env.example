# Runtime
UIUX_HOST=127.0.0.1
# Code workers edit real project files after the design approval gate.
# worktree = isolated git worktree (recommended); direct = target working tree.
UIUX_CODE_EDITS=true
UIUX_CODE_EDIT_MODE=worktree
UIUX_CODE_WORKER_AGENT=build
# UIUX_CODE_WORKER_MODEL=modal/deepseek-v4.1-flash-1017
UIUX_CODE_WORKER_TIMEOUT=900
# Residual intent packet budgets (characters, not tokens)
UIUX_INTENT_PACKET_MAX_CHARS=160000
UIUX_CODE_WORKER_PACKET_CHARS=160000
UIUX_CODE_WORKER_PLAN_CHARS=40000
UIUX_CODE_WORKER_OTHER_CHARS=30000
UIUX_PORT=8765
UIUX_DATA_DIR=./.runtime
UIUX_ARTIFACTS_DIR=./artifacts
UIUX_CHECKPOINT_DB=./.runtime/checkpoints.sqlite3
UIUX_STORAGE_DB=./.runtime/uiux.sqlite3

# Model gateway: opencode | mock
UIUX_MODEL_BACKEND=opencode
UIUX_OPENCODE_BIN=opencode
UIUX_OPENCODE_AGENT=uiux-worker
UIUX_OPENCODE_MODEL=modal/deepseek-v4.1-flash-1017
UIUX_OPENCODE_TIMEOUT=300
UIUX_MAX_CONTEXT_CHARS=180000
# Optional: run OpenCode workers in a clean directory
# UIUX_OPENCODE_CWD=/path/to/clean/workspace

# Approval / autonomy
# L0 advise, L1 spec, L2 PR, L3 auto-merge low risk, L4 auto-release
UIUX_AUTONOMY_LEVEL=L2
UIUX_AUTO_APPROVE=true
UIUX_MAX_REWORK=2

# Auth (optional; copy org/users.yaml.example to org/users.yaml)
UIUX_AUTH=false
# If org/users.yaml is absent, a single token can be supplied here.
# UIUX_AUTH_TOKEN=dictator-dev-token
# UIUX_AUTH_ROLE=dictator

# Notifications
# UIUX_WEBHOOK_URL=https://example.com/hook

# Production storage (optional)
# UIUX_CHECKPOINT_BACKEND=postgres
# UIUX_POSTGRES_DSN=postgresql://uiux:uiux_dev_password@localhost:5432/uiux
# UIUX_S3_BUCKET=uiux-artifacts
# UIUX_S3_ENDPOINT=http://localhost:9000
# UIUX_S3_ACCESS_KEY=uiux
# UIUX_S3_SECRET_KEY=uiux_dev_password

# Token budget (set your monthly ceiling in total tokens)
UIUX_MONTHLY_TOKEN_BUDGET=100000000
UIUX_TOKEN_WARN_PCT=80
UIUX_TOKEN_HARD_STOP_PCT=100

# Target UI
UIUX_TARGET_UI_ENABLED=true
UIUX_TARGET_UI_PATH=./target_ui_example
UIUX_CURRENT_UI_PATH=./current_ui_example
UIUX_TARGET_UI_ANALYZE=true

# LangSmith (optional; set these to enable tracing)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=uiux-agent-company
